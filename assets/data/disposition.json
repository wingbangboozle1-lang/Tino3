  },
  {
   "condition": "Where the property is a dwelling unit the heir also uses personally, the safe harbour needs 24 months of ownership and, in each of the two 12-month periods, 14 days or more of renting at a fair rental with personal use no more than the greater of 14 days or 10% of the rental days",
   "authority": "Rev. Proc. 2008-16, section 4.02",
