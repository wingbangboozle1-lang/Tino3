{
  "assumptions": [
    {
      "id": "appreciation",
      "item": "Property appreciation (nominal, per year)",
      "value": "3.0% / 4.0% / 5.0%",
      "basis": "Scenario band; the base case is 4.0%. Not a forecast."
    },
    {
      "id": "cpi",
      "item": "General inflation / cost growth",
      "value": "2.5%",
      "basis": "Scenario assumption used for insurance, water, utilities and rent growth."
    },
    {
      "id": "prop13_growth",
      "item": "Assessed-value growth while owned (RTC 51)",
      "value": "2.0%",
      "basis": "Statutory 2% cap applies while California CPI exceeds 2%."
    },
    {
      "id": "prop19_cap_growth",
      "item": "Proposition 19 exclusion cap growth",
      "value": "3.0%",
      "basis": "The real cap is recalculated every two years from the FHFA House Price Index for California; the growth rate is a scenario assumption."
    },
    {
      "id": "fed_exclusion_2026",
      "item": "Federal estate exclusion, 2026",
      "value": "$15,000,000",
      "basis": "Statutory amount for deaths in 2026."
    },
    {
      "id": "fed_exclusion_2027",
      "item": "Federal estate exclusion, 2027",
      "value": "$15,480,000",
      "basis": "Published amount for deaths in 2027 (IRS IR-2026-133, 5 Nov 2026; Rev. Proc. 2026-35); verified on integration re-check."
    },
    {
      "id": "fed_exclusion_indexing",
      "item": "Federal exclusion indexing after 2027",
      "value": "2.5%",
      "basis": "Scenario assumption for 2028 onward; the 2026 and 2027 published amounts are verified and used directly."
    },
    {
      "id": "equity_return",
      "item": "Diversified equity return (nominal)",
      "value": "7.0%",
      "basis": "Scenario assumption for the sell-and-reinvest comparison."
    },
    {
      "id": "bond_return",
      "item": "Bond / Treasury return (nominal)",
      "value": "4.0%",
      "basis": "Scenario assumption. Reference: the official 10-year U.S. Treasury par yield was 4.88% on 9 Nov 2026 (cited in the Decision Brief annex ledger); forward yields are unknown."
    },
    {
      "id": "cash_return",
      "item": "Return on accumulated cash",
      "value": "3.0%",
      "basis": "Scenario assumption for reinvested cash flow."
    },
    {
      "id": "rent_growth",
      "item": "Rent growth (nominal)",
      "value": "2.5%",
      "basis": "Scenario assumption. The jurisdiction's published allowable annual increase for covered units is 1.6% for Mar 2026-Feb 2027; regulated increases may be lower than this scenario."
    },
    {
      "id": "rent_yield_a",
      "item": "Gross rent yield on Property A",
      "value": "3.0% of market value per year",
      "basis": "Scenario assumption used because no verified market rent exists for a future year."
    },
    {
      "id": "vacancy",
      "item": "Vacancy and collection allowance",
      "value": "3.0% of gross rent",
      "basis": "Scenario assumption."
    },
    {
      "id": "income_tax",
      "item": "Marginal tax rate on rental income",
      "value": "33.3%",
      "basis": "Scenario: 24% federal plus 9.3% California. Depreciation is ignored, which overstates tax."
    },
    {
      "id": "gain_tax",
      "item": "Tax rate on realised long-term gain",
      "value": "32.3%",
      "basis": "20% federal (IRS Topic 409) plus 12.3% California top bracket (FTB). A 3.8% net investment income tax may add to this."
    },
    {
      "id": "sell_cost",
      "item": "Selling cost on Property A",
      "value": "5.11%",
      "basis": "Scenario: 5.0% commission and escrow plus 0.11% base documentary transfer tax. City-level transfer taxes not verified."
    },
    {
      "id": "maint_rate_a",
      "item": "Maintenance on Property A",
      "value": "0.50% of value",
      "basis": "Scenario assumption."
    },
    {
      "id": "maint_rate_b",
      "item": "Maintenance on Property B",
      "value": "1.00% of value",
      "basis": "Scenario assumption; an older multi-unit building."
    },
    {
      "id": "horizon_end",
      "item": "Comparison horizon",
      "value": "2055",
      "basis": "Ten years after the latest modelled inheritance year."
    },
    {
      "id": "inherit_years",
      "item": "Modelled inheritance years",
      "value": "2040 / 2045 / 2050",
      "basis": "Owner's stated planning window, with the midpoint treated as the base case."
    }
  ],
