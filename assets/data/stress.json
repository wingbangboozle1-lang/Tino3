 "insurance": [
  {
   "item": "What is published",
   "finding": "A 2026 homeowners premium comparison survey for California, by line of coverage",
   "detail": "The Department of Insurance surveys insurers and publishes the results as a comparison. The survey is not a quote and does not price a specific dwelling.",
   "src": [
    "cdi_compare"
   ]
  },
  {
   "item": "Why no premium is shown",
   "finding": "No official premium exists for either property",
   "detail": "Nothing published by an official body prices Property A or Property B. The figures in the model are the owner's placeholders, carried at $1,500 for each property.",
   "src": [
    "cdi_compare"
   ]
  },
  {
   "item": "If an insurer will not write the home",
   "finding": "The FAIR Plan is the residual market, with a residential limit of $3,000,000 per location",
   "detail": "Property A's estimated value is above that limit, so a FAIR Plan-only policy would not cover the whole house; the difference in conditions policy is bought separately. Property B's value is inside the limit.",
   "src": [
    "cdi_fair"
   ]
  },
  {
   "item": "What the FAIR Plan covers",
   "finding": "A limited fire policy, not a comprehensive homeowners policy",
   "detail": "A comprehensive residential option is described by the Department as in progress. Until it exists, water damage, liability, theft and additional living expenses need a separate policy.",
   "src": [
    "cdi_fair"
   ]
  },
  {
   "item": "Effect on the ranking",
   "finding": "None of the shocks tested changes which option is ahead",
   "detail": "At five times the placeholder, insurance is still small against the property tax reset and the lost investment return. The ranking is on the stress page.",
   "src": [
    "cdi_compare"
   ]
  }
 ],
