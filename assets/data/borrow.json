 "rules": {
  "no_income_tax_on_proceeds": {
   "text": "Loan proceeds are not income, so taking cash out does not start a tax bill; the basis step-up at death is unaffected and the gain on a later sale is measured from the same stepped-up basis. The selling cost the model charges the sell path - 5.5 percent of the price in the baseline, which is the whole of its outflow at inheritance because the gain at that date is nil - is the cash a borrow path keeps.",
   "src": [
    "irs_basis",
    "irs_p523"
   ]
  },
  "no_reassessment": {
   "text": "Revenue and Taxation Code section 62(c)(1): a change in ownership does not include the creation, assignment, termination or reconveyance of a security interest, or the substitution of a trustee under a security instrument. Borrowing against the home therefore does not trigger reassessment, and does not disturb the Proposition 19 shelter the way renting the home out can.",
   "src": [
    "rtc62"
   ]
  },
  "interest_not_deductible": {
   "text": "Publication 936 (2025): interest on home equity loans and lines is deductible only if the borrowed funds are used to buy, build or substantially improve the taxpayer's home that secures the loan, and home acquisition debt taken out after 15 December 2017 is limited to $750,000. Cash taken out to invest is outside both. Whether any part of the interest is deductible as investment interest against investment income is a question for the preparer; this site assumes none, which is the conservative reading.",
   "src": [
    "irs_p936"
   ]
  },
  "estate_tax_unaffected": {
   "text": "Nothing on this page reduces federal estate tax. The tax is computed on the estate as it stands at the date of death, and a loan the heir takes after the transfer is the heir's obligation, not the decedent's; the borrowed cash then sits in the heir's own wealth. A debt already registered against the property at the date of death is a different question, and it belongs to the attorney with the Form 706 deduction rules, not to this page.",
   "src": [
    "irs_i706",
    "irs_estate"
   ]
  },
  "lender_limits": {
   "text": "The federal rule that protects the transfer itself is 12 U.S.C. 1701j-3(d): a due-on-sale clause may not be exercised on a transfer to a relative resulting from the borrower's death, or where the borrower's children become owners, for a loan on residential property with fewer than five dwelling units. That protects an existing loan from acceleration; it does not oblige any lender to advance new money, and whether a lender will lend against a property held in a trust is a question for the lender and the trustee.",
   "src": [
    "uscode1701j3"
   ]
  }
 },
 "stress_note": "The stated three-year sequence on this page is the same one the black-swan page uses - minus 40 percent, plus 25 percent, plus 10 percent, then the baseline net return - applied to the invested portfolio annually. It is a stress, not a forecast, and it is not a dated replay. The house price is not shocked in this table; the regime runs on the black-swan page do that, and they already put the living path behind the selling path before any financing overlay is added.",
 "limitation": {
  "not_an_offer": "Loan-to-value rungs of 40, 60 and 80 percent are stated scenarios. No official source publishes what a lender would advance against this property, and this site does not assume a quote exists.",
  "no_underwriting": "Debt-to-income limits, mortgage insurance, prepayment penalties, closing costs and whether a trust-held property is eligible at all are not modelled. Closing costs on a refinance are the one number a lender must supply before any figure here means anything.",
  "cash_flow": "The overlay funds the payment from the borrowed money itself. If the household spends the proceeds, the payment has to come from income, and the cost of the money column is the honest figure to read instead."
 }
